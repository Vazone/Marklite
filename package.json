{
  "name": "marklite",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "description": "A lightweight cross-platform Markdown editor built with Tauri, Rust, Svelte and CodeMirror.",
  "author": "Vazone",
  "license": "MIT",
  "homepage": "https://github.com/Vazone/Marklite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vazone/Marklite.git"
  },
  "keywords": [
    "markdown",
    "markdown-editor",
    "windows",
    "tauri",
    "rust",
    "svelte",
    "codemirror",
    "marklite",
    "desktop-app",
    "notes"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "build:cli": "node scripts/build-cli-launcher.mjs",
    "android:build": "node scripts/android/build.mjs",
    "android:verify": "node scripts/android/verify.mjs",
    "build:diagram-pack": "node scripts/build-mermaid-pack.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packaging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-packaging.ps1",
    "test:startup-diagnostics": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-startup-diagnostics.ps1",
    "test:cli": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-cli.ps1",
    "test:export-artifacts": "node scripts/check-export-artifacts.mjs",
    "audit:rust": "node scripts/audit-rust.mjs",
    "benchmark:generate": "node scripts/performance/generate-corpus.mjs",
    "benchmark:search": "node scripts/performance/measure-editor-search.mjs",
    "benchmark:mind-map": "node --expose-gc scripts/performance/measure-mind-map.mjs",
    "benchmark:windows": "node scripts/performance/run-windows-baseline.mjs",
    "version:check": "node scripts/check-version.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "conformance:markdown": "node scripts/markdown-conformance.mjs",
    "conformance:diagrams": "node scripts/diagram-conformance.mjs",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "package:linux": "node scripts/package-linux.mjs",
    "tauri": "tauri",
    "test:native-regressions": "node scripts/test-native-regressions.mjs",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "test:update-manifest": "node --test scripts/tests/update-*.test.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.38.6",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.6.3",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "2.12.0",
    "lucide-svelte": "^1.0.1",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^25.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "mermaid": "11.17.2",
    "svelte-check": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "4.1.11"
  }
}
